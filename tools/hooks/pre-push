#!/bin/sh
# Гейт публикации: синтаксис + семантика.
#
# Синтаксис прогоняется заново, а не «уже проверено на коммите»: коммит могли
# сделать в обход хука, и push — последний рубеж перед тем, как код уедет
# наружу и станет виден другим.
#
# Семантика — то, что нельзя увидеть по тексту файла: сходится ли разметка с
# данными, не поехала ли система координат дверей, не разошлись ли числа с
# зафиксированным baseline. Это запуск пайплайна по кэшу треков, поэтому он
# дешёвый (единицы секунд) — но требует видео и кэша, которых в репозитории
# нет. На машине без данных семантические гейты пропускаются с явным
# сообщением, а не молча.
set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
FAILED=0

echo "── синтаксические гейты ─────────────────────────────"
# stdin даёт строки «<local ref> <local sha> <remote ref> <remote sha>».
# Ветка, которую удаляют, приходит с нулевым local sha — проверять нечего.
ZERO="0000000000000000000000000000000000000000"
CHECKED=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$ZERO" ] && continue
    case " $CHECKED " in *" $local_sha "*) continue;; esac
    CHECKED="$CHECKED $local_sha"
    python3 tools/hooks/gate_syntax.py --rev "$local_sha" || FAILED=1
done
# Пуш без stdin (ручной вызов хука для проверки) — смотрим текущий HEAD.
if [ -z "$CHECKED" ]; then
    python3 tools/hooks/gate_syntax.py --rev HEAD || FAILED=1
fi

echo
echo "── семантические гейты ──────────────────────────────"
# Разметка проверяется всегда: ей не нужны ни видео, ни окружение проекта, а
# ошибки в ней — самый дорогой класс дефектов (тихие: прогон не падает, просто
# счёт становится неверным).
echo "· разметка дверей"
python3 tools/hooks/gate_zones.py || FAILED=1

# Память решений: заголовки, закрытые словари, сверка каталога с набором файлов.
# Данных не требует, поэтому идёт до всего, что упирается в видео.
echo "· память решений"
python3 tools/hooks/gate_memory.py || FAILED=1

# Не блокирующее предупреждение: диф тронул файл, на который ссылается запись,
# а сама запись не тронута. Блокировать нельзя — получится рефлекс «жать не
# глядя», ровно тот, от которого избавились в гейте baseline.
if [ -d docs/decisions ]; then
    CHANGED=$(git diff --name-only HEAD~1..HEAD 2>/dev/null || true)
    TOUCHED=$(printf '%s\n' "$CHANGED" | grep '^docs/decisions/' || true)
    if [ -z "$TOUCHED" ]; then
        for f in $CHANGED; do
            HITS=$(grep -rl "file:$f" docs/decisions/ 2>/dev/null | grep -v 'README.md' || true)
            if [ -n "$HITS" ]; then
                echo "  ⚠ затронут $f, на него ссылаются записи:"
                for h in $HITS; do echo "      $(basename "$h")"; done
                echo "    если поведение изменилось — обновите запись"
            fi
        done
    fi
fi

# Тесты идут до гейтов, требующих данных: они не зависят ни от видео, ни от
# кэша, отрабатывают за доли секунды и покрывают ровно те дефекты, которые в
# прошлый раз были найдены руками (принцип 8).
#
# Здесь `--group`, а в CI `--only-group`, и это не разнобой. Локальное `.venv`
# собрано под весь проект; `--only-group` пересобрал бы его под одну тестовую
# группу, вышиб torch, а следующий гейт `paxcount check` тут же вернул бы его
# назад — окружение болталось бы на каждом push. В CI окружения нет вообще,
# и там `--group` означал бы установку torch ради юнит-тестов.
if command -v uv >/dev/null 2>&1; then
    echo "· тесты"
    uv run --group test pytest || FAILED=1
fi

if ! command -v uv >/dev/null 2>&1; then
    echo "· uv не найден — семантические гейты пропущены"
elif [ -z "$(find data/test_videos data/prod_videos -type f \
        \( -name '*.webm' -o -name '*.mp4' -o -name '*.ogv' -o -name '*.mov' \
           -o -name '*.avi' -o -name '*.mkv' \) 2>/dev/null)" ]; then
    echo "· видео нет — семантические гейты пропущены."
    echo "  Это ожидаемо на свежем клоне: кадры не версионируются (лица и номера машин),"
    echo "  см. data/test_videos/SOURCES.md и data/prod_videos/README.md"
else
    # 1. Набор согласован сам с собой: файлы читаются, эталон и разметка
    #    ссылаются на существующие видео, зоны в допустимых долях, вертикальные
    #    границы дверных зон — полоса ног, а не высота проёма.
    echo "· paxcount check"
    uv run paxcount check || FAILED=1

    # 2. Система координат дверей не едет: внутри окна стационарного визита
    #    дверная зона обязана стоять ровно 0px. Это инвариант по построению —
    #    ненулевое значение означает, что мимо build_scene просочился сырой bbox.
    echo "· paxcount doors jitter"
    uv run paxcount doors jitter >/dev/null || FAILED=1

    # 3. Числа не разъехались с зафиксированными. Гейт не требует «стало лучше»,
    #    он требует осознанности: изменил результат — объясни и пересохрани
    #    baseline командой `paxcount baseline --save`.
    echo "· paxcount baseline"
    uv run paxcount baseline >/dev/null || FAILED=1
fi

echo
if [ "$FAILED" -ne 0 ]; then
    echo "✗ push остановлен: гейты не пройдены (подробности выше)"
    exit 1
fi
echo "✓ все гейты пройдены"
