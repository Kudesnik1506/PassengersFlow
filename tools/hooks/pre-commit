#!/bin/sh
# Гейт коммита: только синтаксические проверки — они мгновенные и не требуют
# ни окружения проекта, ни данных. Семантика (запуск пайплайна против эталона)
# живёт в pre-push: гонять её на каждый коммит значит платить за то, чего ещё
# никто не видел.
exec python3 "$(git rev-parse --show-toplevel)/tools/hooks/gate_syntax.py" --staged
