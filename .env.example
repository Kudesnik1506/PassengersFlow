# Образец: скопируйте в .env и подставьте выданные заказчиком значения.
# Сам .env закрыт в .gitignore — учётка в репозиторий не попадает.
PORTAL_URL=https://portal.gpt.adc.spb.ru/Portal/transport/personal/vehicleSearch
PORTAL_LOGIN=
PORTAL_PASSWORD=

# Фамилия и имя расшифровщика — графа O бланка. Постоянна: расшифровщик один и
# тот же от работы к работе. Здесь, а не в репозитории, потому что репозиторий
# открыт, а это имя живого человека (решение 016).
DECODER_NAME=Фамилия Имя
