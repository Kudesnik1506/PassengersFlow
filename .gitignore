.venv/
__pycache__/
*.pyc
logs/
out/
models/*.pt
# Веса CLIP, которые тянет tools/bake_world_doors.py при запекании классов.
# Нужны только для разового запекания — рантайм грузит готовые веса без CLIP.
weights/

# Персональные данные: кадры с лицами и номерами машин наружу не уходят.
# Закрыты папки целиком, а не перечисление расширений: список расширений уже
# отставал от VIDEO_SUFFIXES (.mov, .avi, .mkv в него не входили), а цена
# промаха необратима — опубликованное из истории не вернуть. Из папок
# отслеживаются только текстовые описания, названные явными исключениями.
data/test_videos/*
!data/test_videos/SOURCES.md
data/prod_videos/*
!data/prod_videos/README.md
data/cache/

# Синтетические склейки — это те же кадры с лицами, только пересобранные
data/synthetic/*.mp4
data/synthetic/*.webm
data/synthetic/*.ogv

# Резервные копии разметки, сделанные перед правками
data/zones.backup-*/

.DS_Store

# Документы заказчика. Закрыты целиком и по той же причине, что и видео:
# в инструкции расшифровщика лежит рабочий логин и пароль к транспортному
# порталу Санкт-Петербурга, в примере заполненной таблицы — 130 реальных
# госномеров и фамилия расшифровщика. Репозиторий публичный (решение 016),
# гейт секретов ловит ключи известных форматов, а пароль к порталу — нет.
docs/документы от Заказчика/

# Учётные данные. Правило идёт ПЕРЕД созданием файла, а не после: порядок здесь
# и есть защита — .env, созданный раньше правила, попадает в `git add -A`.
# Образец без секретов — .env.example, он отслеживается.
.env
!.env.example
