.venv/
__pycache__/
*.pyc
logs/
out/
models/*.pt
# Веса CLIP, которые тянет tools/bake_world_doors.py при запекании классов.
# Нужны только для разового запекания — рантайм грузит готовые веса без CLIP.
weights/

# Персональные данные: кадры с лицами и номерами машин наружу не уходят.
# Закрыты папки целиком, а не перечисление расширений: список расширений уже
# отставал от VIDEO_SUFFIXES (.mov, .avi, .mkv в него не входили), а цена
# промаха необратима — опубликованное из истории не вернуть. Из папок
# отслеживаются только текстовые описания, названные явными исключениями.
data/test_videos/*
!data/test_videos/SOURCES.md
data/prod_videos/*
!data/prod_videos/README.md
data/cache/

# Синтетические склейки — это те же кадры с лицами, только пересобранные
data/synthetic/*.mp4
data/synthetic/*.webm
data/synthetic/*.ogv

# Резервные копии разметки, сделанные перед правками
data/zones.backup-*/

.DS_Store
